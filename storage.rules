rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Public read for all files
    match /{allPaths=**} {
      allow read: if true;
    }
    // Only admin can upload to founders
    match /founders/{file} {
      allow write: if request.auth != null
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.is_admin in [1, true];
    }
    // Only admin can upload to gallery (matches any file inside gallery/)
    match /gallery/{allPaths=**} {
      allow write: if request.auth != null
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.is_admin in [1, true];
    }
  }
}
