rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────
    function isSignedIn() { return request.auth != null; }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.is_admin in [1, true];
    }

    // Active, non-deleted employee only
    function isEmployee() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/employees/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/employees/$(request.auth.uid)).data.is_active in [1, true] &&
        get(/databases/$(database)/documents/employees/$(request.auth.uid)).data.get('deleted', false) != true;
    }

    // Receptionist is an active employee with role == 'receptionist'
    function isReceptionist() {
      return isEmployee() &&
        get(/databases/$(database)/documents/employees/$(request.auth.uid)).data.role == 'receptionist';
    }

    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }

    // ── Users ─────────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isOwner(uid) || isAdmin();
    }

    // ── Usernames (login lookup map) ──────────────────────────────────────
    match /usernames/{username} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // ── Employees ─────────────────────────────────────────────────────────
    match /employees/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isAdmin() || isOwner(uid);
      allow update: if isAdmin() || isOwner(uid);
      allow delete: if isAdmin();
    }

    // ── Services (public read) ─────────────────────────────────────────────
    match /services/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Enquiries ─────────────────────────────────────────────────────────
    match /enquiries/{id} {
      allow read: if isAdmin() || isEmployee();
      allow create: if true;
      allow update: if isAdmin() || isEmployee();
      allow delete: if isAdmin();
    }

    // ── Attendance ────────────────────────────────────────────────────────
    match /attendance/{id} {
      allow read: if isAdmin() || isEmployee();
      allow write: if isAdmin() || isReceptionist();
    }

    // ── Leave Requests ────────────────────────────────────────────────────
    match /leave_requests/{id} {
      allow read: if isAdmin() || (isEmployee() && resource.data.employee_id == request.auth.uid);
      allow create: if isEmployee();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── Payroll ───────────────────────────────────────────────────────────
    match /payroll/{id} {
      allow read: if isAdmin() || (isEmployee() && resource.data.employee_id == request.auth.uid);
      allow write: if isAdmin();
    }

    // ── Reviews ───────────────────────────────────────────────────────────
    match /reviews/{id} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isAdmin() || (isSignedIn() && resource.data.user_id == request.auth.uid);
      allow delete: if isAdmin();
    }

    // ── Gallery (public read) ──────────────────────────────────────────────
    match /gallery/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Offers (public read) ───────────────────────────────────────────────
    match /offers/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Settings (public read) ─────────────────────────────────────────────
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Bills ─────────────────────────────────────────────────────────────
    match /bills/{id} {
      allow read: if isAdmin() || isEmployee();
      allow create: if isAdmin() || isEmployee();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── Billing Customers ─────────────────────────────────────────────────
    match /billing_customers/{id} {
      allow read: if isAdmin() || isEmployee();
      allow create: if isAdmin() || isEmployee();
      allow update: if isAdmin() || isEmployee();
      allow delete: if isAdmin();
    }
  }
}
